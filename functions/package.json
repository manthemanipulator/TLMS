{
  "name": "tlms-functions",
  "description": "Cloud Functions integration layer for the Tournament & League Management System",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test \"bracket/test/*.test.js\" \"test/unit/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tlms \"node --test test/rules.test.js\"",
    "test:api": "firebase emulators:exec --only auth,firestore --project demo-tlms \"node --test test/api.test.js\"",
    "test:all": "npm test && npm run test:rules && npm run test:api",
    "seed": "node scripts/seed.js",
    "test:scoring": "node scripts/simulate-paper-golf.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  }
}
